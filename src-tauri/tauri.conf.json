{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nubara-talk",
  "version": "0.1.0",
  "identifier": "com.nubara-talk.app",
  "build": {
    "frontendDist": "../src/ui/web"
  },
  "app": {
    "windows": [
      {
        "title": "nubara-talk",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ws://127.0.0.1:8765; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
